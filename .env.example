# Copy this file to ".env" in the same folder (mtaabiz/.env) and fill in
# real values. Never commit the real ".env" file to git.

# Django secret key - generate a new one for production.
# You can generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-CHANGE-THIS-KEY-IN-PRODUCTION-0000000000000

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset (or delete this line) to use local SQLite during development.
# In production, set this to your PostgreSQL connection string, e.g:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Only relevant when DEBUG=False
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com
